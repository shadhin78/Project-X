rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Lock down everything by default
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Protect the studyPlan collection - only allow access for the whitelisted Google account
    match /studyPlan/{document} {
      allow read, write: if request.auth != null && request.auth.token.email == 'ris2k29@gmail.com';
    }
  }
}
